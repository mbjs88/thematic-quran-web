# Local-only secrets for the labeler pipeline.
# Copy this file to `.env` (which is gitignored) and fill in your real values.
#
# Get a key from https://console.anthropic.com  -> Settings -> API keys.
#
# The labeler reads this file fresh on every API call, so you can change the
# key without restarting `python3 server.py`.
ANTHROPIC_API_KEY={sample_key}

# Default model — pick one of:
#   claude-haiku-4-5-20251001   (cheap, fast)
#   claude-sonnet-4-6            (default; the pilots' implicit choice)
#   claude-opus-4-6              (best; expensive; reserve for narrative-heavy surahs)
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# ---- Overview tafsir compilation pipeline (scripts/overview_pipeline) ----
# Model for the whole-Qurʾan Overview run. Opus 4.8 as chosen.
OVERVIEW_MODEL=claude-opus-4-8
# Modern-lens (scientific reflection) mode: "manual" (batch = grounded reading only;
# science layer added in a verified pass) or "draft" (batch proposes unverified candidates).
OVERVIEW_MODERN_LENS=manual

# Quran Foundation content API — used by the batch path to fetch tafsir.
# Same credentials the site's /api/qf-public proxy uses (see .dev.vars).
QF_CLIENT_ID={sample_key}
QF_CLIENT_SECRET={sample_key}
# Override only if your account's endpoints differ:
# QF_API_BASE=https://apis.quran.foundation/content/api/v4
# QF_AUTH_URL=https://oauth2.quran.foundation/oauth2/token

# Optional during the manual news pilot. Required once Sunnah.com retrieval is automated.
SUNNAH_COM_API_KEY={sample_key}
