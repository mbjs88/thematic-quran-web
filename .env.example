# Local-only secrets for the labeler pipeline.
# Copy this file to `.env` (which is gitignored) and fill in your real values.
#
# Get a key from https://console.anthropic.com  -> Settings -> API keys.
#
# The labeler reads this file fresh on every API call, so you can change the
# key without restarting `python3 server.py`.
ANTHROPIC_API_KEY={sample_key}

# Default model — pick one of:
#   claude-haiku-4-5-20251001   (cheap, fast)
#   claude-sonnet-4-6            (default; the pilots' implicit choice)
#   claude-opus-4-6              (best; expensive; reserve for narrative-heavy surahs)
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
